<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Remote Video View (Background) -->
    <FrameLayout
        android:id="@+id/remote_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true" />

    <!-- Local Video View (PiP - Picture in Picture) -->
    <FrameLayout
        android:id="@+id/local_video_view"
        android:layout_width="150dp"
        android:layout_height="200dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:background="@android:color/darker_gray"
        android:elevation="10dp" />

    <!-- Call Status and Duration Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="32dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/call_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting..."
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/call_duration_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Control Buttons at Bottom -->
    <LinearLayout
        android:id="@+id/controls_layout"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:background="@android:color/darker_gray">

        <!-- Toggle Audio Button -->
        <ImageView
            android:id="@+id/toggle_audio_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/callicon"
            android:contentDescription="Toggle Audio"
            android:background="@drawable/circular_button_bg"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:layout_margin="8dp" />

        <!-- Toggle Video Button -->
        <ImageView
            android:id="@+id/toggle_video_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/videocameraicon"
            android:contentDescription="Toggle Video"
            android:background="@drawable/circular_button_bg"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:layout_margin="8dp" />

        <!-- Switch Camera Button -->
        <ImageView
            android:id="@+id/switch_camera_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/cameralogo"
            android:contentDescription="Switch Camera"
            android:background="@drawable/circular_button_bg"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:layout_margin="8dp" />

        <!-- End Call Button (Red) -->
        <ImageView
            android:id="@+id/end_call_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/callicon"
            android:contentDescription="End Call"
            android:background="@drawable/circular_button_bg_red"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:layout_margin="8dp" />
    </LinearLayout>
</RelativeLayout>