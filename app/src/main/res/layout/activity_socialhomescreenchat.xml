<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header with Back, Title, and Call Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/white"
        android:layout_marginTop="10dp"
        android:elevation="4dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/cameralogo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/leftshortarrow"
            android:contentDescription="Back" />

        <!-- Chat Header Title -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chat_header"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />

        <!-- Voice Call Button -->
        <ImageView
            android:id="@+id/call"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/callicon"
            android:contentDescription="Voice Call"
            android:layout_marginEnd="12dp" />

        <!-- Video Call Button -->
        <ImageView
            android:id="@+id/videoCall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/videocameraicon"
            android:contentDescription="Video Call" />
    </LinearLayout>

    <!-- Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="8dp" />

    <!-- Message Input Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_marginBottom="40dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <!-- Message Input EditText -->
        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="Message..."
            android:background="@drawable/rounded_input"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <!-- Send Button -->
        <ImageView
            android:id="@+id/sendButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/sendicon"
            android:contentDescription="Send"
            android:scaleType="centerInside"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>